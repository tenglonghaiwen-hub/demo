{
  "name": "ai-desktop-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "独立 Windows AI 助手候选骨架",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.electron.json && vite build --base ./ --outDir dist/renderer --emptyOutDir false",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
