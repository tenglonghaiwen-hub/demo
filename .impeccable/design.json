  "components": [
    {
      "name": "默认按钮",
      "kind": "button",
      "html": "<button class=\"ds-button\">重命名</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,8px);min-height:34px;padding:var(--space-1,4px) var(--space-3,12px);border:1px solid var(--border,#dce0e6);border-radius:var(--radius-control,8px);background:var(--surface,#fff);color:var(--text,#242831);font:13px/1.6 \"Segoe UI\",\"Microsoft YaHei\",sans-serif;cursor:pointer;transition:background var(--duration,170ms) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover:not(:disabled){background:var(--hover,#e7eaf0)}.ds-button:active:not(:disabled){background:var(--selected,#e2ecfb)}.ds-button:disabled{opacity:.48;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--accent,#185cbd);outline-offset:3px}"
    },
    {
      "name": "主保存按钮",
      "kind": "button",
      "html": "<button class=\"ds-button ds-primary\">保存草稿</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,8px);min-height:34px;padding:var(--space-1,4px) var(--space-3,12px);border:1px solid var(--border,#dce0e6);border-radius:var(--radius-control,8px);background:var(--surface,#fff);color:var(--text,#242831);font:13px/1.6 \"Segoe UI\",\"Microsoft YaHei\",sans-serif;cursor:pointer;transition:background var(--duration,170ms) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover:not(:disabled){background:var(--hover,#e7eaf0)}.ds-button:active:not(:disabled){background:var(--selected,#e2ecfb)}.ds-button:disabled{opacity:.48;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--accent,#185cbd);outline-offset:3px}.ds-primary{background:var(--accent,#185cbd);color:var(--surface,#fff);border-color:transparent}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#104b9e)}"
    },
    {
      "name": "重命名输入",
      "kind": "input",
      "html": "<label class=\"ds-label\">会话名称<input class=\"ds-input\" value=\"本地草稿\"></label>",
      "css": ".ds-label{display:grid;gap:8px;color:var(--text,#242831);font:13px/1.6 \"Segoe UI\",\"Microsoft YaHei\",sans-serif}.ds-input{font:inherit;padding:var(--space-2,8px);border:1px solid var(--border,#dce0e6);border-radius:var(--radius-small,6px);background:var(--surface,#fff);color:var(--text,#242831);caret-color:var(--accent,#185cbd)}.ds-input:focus-visible{outline:2px solid var(--accent,#185cbd);outline-offset:3px}"
    },
