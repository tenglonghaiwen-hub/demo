      "html": "<button class=\"ds-button ds-session\" aria-current=\"page\"><span>本地草稿</span><small>未保存</small></button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2,8px);min-height:34px;padding:var(--space-1,4px) var(--space-3,12px);border:1px solid var(--border,#dce0e6);border-radius:var(--radius-control,8px);background:var(--surface,#fff);color:var(--text,#242831);font:13px/1.6 \"Segoe UI\",\"Microsoft YaHei\",sans-serif;cursor:pointer;transition:background var(--duration,170ms) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover:not(:disabled){background:var(--hover,#e7eaf0)}.ds-button:active:not(:disabled){background:var(--selected,#e2ecfb)}.ds-button:disabled{opacity:.48;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--accent,#185cbd);outline-offset:3px}.ds-session{flex-direction:column;align-items:flex-start;border:0;padding:8px 12px;gap:0;background:var(--selected,#e2ecfb);color:var(--selected-text,#174f9e)}.ds-session small{font-size:12px;color:var(--text-muted,#626874)}"
